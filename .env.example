# Modèle à copier en ".env" (fichier réel, non suivi par git) pour renseigner
# ses propres identifiants PostgreSQL locaux. Lu par core/db.py::get_connection()
# via python-dotenv, uniquement pour scripts/phase13_build_datawarehouse_main.py.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=python_ad_audit_dwh
DB_USER=postgres
DB_PASSWORD=TTTTTTTT

# Clé API Groq (console.groq.com), utilisée par l'assistant SOC (Phase 16,
# core/wallix_agent.py::explain_session) pour générer un résumé en langage
# naturel d'une session Wallix suspecte, depuis l'onglet UEBA du dashboard.
# Sans cette variable, le bouton "Expliquer cette session" affiche un
# message d'erreur clair plutôt que de planter le dashboard.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx